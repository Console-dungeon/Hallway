# Copy to .env (`cp .env.example .env`). Values below match docker-compose.yml
# and are safe dev-only defaults. Never put real credentials in this file.

# --- API (apps/api) ---
API_HOST=127.0.0.1
API_PORT=3001
LOG_LEVEL=info

# --- PostgreSQL (docker compose: postgres) ---
DATABASE_URL=postgres://hallway:hallway@127.0.0.1:5432/hallway

# --- Azure Blob Storage (docker compose: azurite) ---
# Well-known Azurite development account – public key from the Azurite docs, not a secret.
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;

# --- Auth (Better Auth, served by the API under /api/auth) ---
# Dev-only value. On servers generate a real one: `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public origin of the app; locally `next dev` proxies /api to the API
BETTER_AUTH_URL=http://localhost:3000

# --- E-mail (docker compose: mailpit, UI at http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# Mailpit needs no credentials; set both for a real SMTP provider
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hallway <no-reply@hallway.local>
