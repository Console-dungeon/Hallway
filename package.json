{
  "name": "hallway",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @hallway/db db:generate",
    "db:migrate": "pnpm --filter @hallway/db db:migrate",
    "db:studio": "pnpm --filter @hallway/db db:studio"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@hallway/config": "workspace:*",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7"
  }
}
